# --- Base de données ---------------------------------------------------------
POSTGRES_USER=bbp
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=bbp

# --- Sessions ----------------------------------------------------------------
# Générez-le avec : openssl rand -hex 32
# L'API refuse de démarrer si cette valeur est vide.
JWT_SECRET=

# --- Discord OAuth2 ----------------------------------------------------------
# https://discord.com/developers/applications -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://pronos.mondomaine.fr/api/auth/discord/callback

# --- URL publique ------------------------------------------------------------
PUBLIC_WEB_URL=https://pronos.mondomaine.fr

# Identifiants Discord promus admin dès leur première connexion (séparés par des virgules).
# Le tout premier compte connecté devient admin de toute façon.
BOOTSTRAP_ADMIN_DISCORD_IDS=
