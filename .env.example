# Modèle de configuration. Copier en `.env` dans le dossier de la pile, puis
# remplir. Le fichier réel n'est jamais versionné ni embarqué dans les images.
#
# ─── Identité de la pile ────────────────────────────────────────────────────
# Préfixe des conteneurs, du réseau et des volumes. À ne renseigner QUE sur la
# préproduction : le changer sur une pile existante la ferait repartir sur des
# volumes vides. En production, laisser Compose déduire le nom du dossier.
# COMPOSE_PROJECT_NAME=bbp-dev

# « prod » ou « dev ». Allume le marqueur d'environnement dans l'en-tête.
APP_ENV=prod

# ─── Ports exposés sur la boucle locale ─────────────────────────────────────
# Deux piles ne peuvent pas réserver le même port. Prod : 8083 / 5432.
# Préprod : 8084 / 5433.
WEB_PORT=8083
DB_PORT=5432

# ─── Base de données ────────────────────────────────────────────────────────
POSTGRES_USER=bbp
POSTGRES_PASSWORD=
POSTGRES_DB=bbp

# ─── Session ────────────────────────────────────────────────────────────────
# Secret distinct par environnement : un jeton de préproduction ne doit jamais
# ouvrir une session en production.
JWT_SECRET=

# ─── Discord ────────────────────────────────────────────────────────────────
# Une application Discord par environnement. L'URL de rappel doit être déclarée
# à l'identique dans « OAuth2 → Redirects » du portail développeur.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://beatboxpredictions.com/api/auth/discord/callback
PUBLIC_WEB_URL=https://beatboxpredictions.com

# Identifiants Discord promus administrateurs au premier démarrage.
BOOTSTRAP_ADMIN_DISCORD_IDS=

# ─── Webhooks ───────────────────────────────────────────────────────────────
# À laisser vides en préproduction : les messages sont enregistrés mais pas
# relayés, et le rapport quotidien ne se planifie pas du tout.
DISCORD_WEBHOOK_SUGGESTIONS=
DISCORD_WEBHOOK_BUGS=
DISCORD_WEBHOOK_REPORTS=

REPORT_DAYS=30
REPORT_CRON=5 8 * * *
REPORT_TZ=Europe/Paris
QUICKCHART_URL=

# ─── Médias ─────────────────────────────────────────────────────────────────
# Dossier des photos de beatboxers sur l'hôte, monté en lecture seule. Les deux
# piles pointent sur le même.
ARTIST_PHOTOS_HOST_DIR=