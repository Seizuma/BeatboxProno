# --- Base de données ---------------------------------------------------------
POSTGRES_USER=bbp
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=bbp

# --- Sessions ----------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=

# --- Application Discord -----------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://predictions.mondomaine.fr/api/auth/discord/callback

# URL publique du site, sans slash final.
PUBLIC_WEB_URL=https://predictions.mondomaine.fr

# Identifiants Discord promus admin à leur première connexion (séparés par des
# virgules). Facultatif : le tout premier compte inscrit devient admin.
BOOTSTRAP_ADMIN_DISCORD_IDS=

# --- Photos des artistes -----------------------------------------------------
# Chemin ABSOLU, côté VPS, du dossier de photos de l'autre projet. Monté en
# lecture seule sur /media/artists dans le conteneur api.
ARTIST_PHOTOS_HOST_DIR=/srv/Beatbox-Games/server/beatbox_artists
