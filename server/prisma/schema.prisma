// ---------------------------------------------------------------------------
// Beatbox Pronos — modèle de données
// ---------------------------------------------------------------------------
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Comptes -----------------------------------------------------------------

enum Role {
  USER
  ADMIN
  OWNER   // le propriétaire du site : un seul, qu'aucun admin ne peut destituer
}

model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  globalName  String?
  avatarUrl   String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  // Le bannissement. Une DATE et non un booléen : « depuis quand » est la
  // première question posée quand quelqu'un conteste, et un booléen doublé
  // d'une date finit toujours par se contredire.
  //
  // Le compte reste en base. Ses pronostics déposés restent au classement :
  // les effacer réécrirait le palmarès de tous les autres, qui n'ont rien
  // fait. Pour tout retirer, c'est la suppression qu'il faut, pas le
  // bannissement — les deux gestes existent et ne se remplacent pas.
  bannedAt    DateTime?
  // Le motif, pour l'administration seule. Jamais rendu au compte banni : la
  // page de connexion ne dit pas pourquoi, elle dit que c'est fermé.
  banReason   String?

  // La dernière note de version lue, par son identifiant — « 2026-08-24 ».
  // Une colonne plutôt qu'une table de lectures : il n'y a qu'une chose à
  // retenir par personne, et les notes sont ordonnées.
  lastReadRelease String?

  // Cinq emplacements, cinq colonnes. Le nom de l'objet porté et rien d'autre :
  // le catalogue vit dans le code, la base ne retient que la tenue. Aucune
  // contrainte de clé étrangère — un objet retiré du catalogue doit pouvoir
  // disparaître sans qu'une migration soit nécessaire, et la migration de
  // remboursement délie les colonnes devenues orphelines.
  equippedFrame    String?
  equippedNameFx   String?
  equippedBand     String?
  equippedCardSkin String?
  equippedStamp    String?

  predictions Prediction[]
  postbox     PostboxMessage[]
  visits      Visit[]
  memberships GroupMember[]
  comments    GroupComment[]
  wallet      WalletEntry[]
  badges      BadgeAward[]
  // Les avis reçus, et ceux qu'on a déclenchés chez les autres. Deux relations
  // vers le même modèle : Prisma exige alors qu'on les nomme.
  notifications Notification[] @relation("Notified")
  triggered     Notification[] @relation("Actor")
  stamps      GroupStamp[]
  viewsMade     ProfileView[] @relation("ProfileViewer")
  viewsReceived ProfileView[] @relation("ProfileViewed")

  // Les événements dont ce compte est écarté, et ceux qu'il a écartés lui-même
  // en tant qu'organisateur. Deux relations vers le même modèle : Prisma exige
  // alors qu'on les nomme.
  exclusions     EventExclusion[] @relation("Excluded")
  exclusionsMade EventExclusion[] @relation("ExclusionAuthor")
}

// --- Référentiel artistes -----------------------------------------------------

// Les formats dans lesquels un artiste se produit. Un même beatboxer peut
// concourir en solo ET faire partie d'un crew : d'où une liste, pas une valeur.
enum ArtistKind {
  SOLO
  TAG_TEAM
  LOOPSTATION
  CREW
  PRODUCER
}

model Artist {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  kinds     ArtistKind[] @default([])
  country   String?
  aliases   String[] @default([])
  imageUrl  String?
  bio       String?
  createdAt DateTime @default(now())

  entries   ContenderArtist[]

  views ProfileView[]
}

// --- Événements ---------------------------------------------------------------

enum EventStatus {
  DRAFT      // invisible du public
  OPEN       // pronostics ouverts
  LIVE       // en cours, phases verrouillées au fur et à mesure
  FINISHED   // tout est résolu et scoré
}

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  year        Int
  location    String?
  startsAt    DateTime?
  endsAt      DateTime?
  coverUrl    String?
  description String?
  status      EventStatus @default(DRAFT)

  // Nombre de juges de la compétition. Détermine les scores proposables :
  // 3 juges donnent 3-0 et 2-1 ; 5 juges ouvrent 5-0, 4-1 et 3-2.
  judgeCount  Int         @default(3)

  /// Le JEU de badges décerné par cette compète, ou rien.
  ///
  /// ─── Pourquoi un identifiant et pas un booléen ───────────────────────────
  ///
  /// Un booléen ne savait dire que « des badges » ou « pas de badges », et les
  /// badges étaient forcément les mêmes partout : sept dessins pour tout le
  /// site. Une sélection de wildcards à vingt joueurs décernait donc les
  /// médailles du Grand Beatbox Battle.
  ///
  /// Ici la compète désigne une FAMILLE de dessins. `null` veut dire qu'elle
  /// n'en décerne aucun ; « gbb » désigne les cubes actuels. Le jour où une
  /// autre famille est dessinée, elle s'ajoute au registre côté client et
  /// devient sélectionnable — sans toucher ni au barème ni à la distribution.
  ///
  /// La valeur n'est pas une énumération : le catalogue des dessins vit dans le
  /// client, et graver ses identifiants dans le schéma obligerait à une
  /// migration pour chaque nouvelle famille.
  badgeSet     String?

  /// Cette compète crédite-t-elle le porte-monnaie ?
  ///
  /// Indépendant des badges, et c'est tout l'intérêt : un championnat peut très
  /// bien rapporter des points de boutique sans décerner les médailles d'une
  /// autre compète. Les deux étaient liés par un seul booléen, ce qui obligeait
  /// à renoncer aux crédits pour se débarrasser des badges.
  awardsCredits Boolean   @default(true)

  // Fermeture globale des pronostics. Volontairement nullable : quand les
  // wildcards sont ouvertes mais que la date de la compète n'est pas connue,
  // on ne ferme rien — seuls les verrous de phase s'appliquent.
  predictionsCloseAt DateTime?
  createdAt   DateTime    @default(now())

  categories  Category[]
  predictions Prediction[]
  groups      GroupEvent[]
  notifications Notification[]
  wallet      WalletEntry[]
  badges      BadgeAward[]
  exclusions  EventExclusion[]
}

/// Un compte écarté d'UN événement.
///
/// Distinct du bannissement, et volontairement : bannir ferme le site entier,
/// ce qui est disproportionné quand le problème tient à une seule compète —
/// quelqu'un qui a triché sur le GBB 2026 n'a pas de raison de perdre l'accès
/// au reste du site. L'exclusion est le cran d'en dessous.
///
/// Elle n'efface RIEN. Les pronostics déjà déposés restent en base et au
/// classement : les retirer est un second geste, délibéré, qui passe par la
/// suppression de pronostic. Confondre les deux ferait disparaître des points
/// sans qu'on l'ait demandé.
model EventExclusion {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("Excluded", fields: [userId], references: [id], onDelete: Cascade)

  /// Le motif, pour l'administration seule. Obligatoire à la pose : la seule
  /// réponse possible à « pourquoi ? » six mois plus tard serait sinon « je ne
  /// sais plus ».
  reason    String
  createdAt DateTime @default(now())

  /// Qui a posé l'exclusion. `SetNull` et non `Cascade` : le départ de
  /// l'organisateur ne doit pas lever l'exclusion qu'il avait décidée.
  byId      String?
  by        User?    @relation("ExclusionAuthor", fields: [byId], references: [id], onDelete: SetNull)

  // Un compte n'est écarté qu'une fois par événement.
  @@unique([eventId, userId])
  // Le contrôle se fait à chaque écriture de pronostic, par (événement, compte) :
  // c'est l'unicité ci-dessus qui le porte. Cet index-ci sert la question
  // inverse, « de quoi ce compte est-il écarté ? », posée sur sa fiche.
  @@index([userId])
}

model GroupStamp {
  id           String     @id @default(cuid())
  groupId      String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  itemId       String
  x            Float
  y            Float
  createdAt    DateTime   @default(now())
  

  @@unique([groupId, predictionId, authorId])
  @@index([groupId, predictionId])
}

enum CategoryKind {
  SOLO         // éliminations -> bracket
  TAG_TEAM     // éliminations -> bracket
  LOOPSTATION  // bracket direct
  CREW         // élimination -> grande + petite finale
  LEGACY       // battles isolées
}

model Category {
  id        String       @id @default(cuid())
  eventId   String
  event     Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind      CategoryKind
  name      String       // "Solo", "Tag Team", "Loopstation"...

  /// Le nom en anglais, quand le nom français n'en est pas un.
  ///
  /// ─── Pourquoi une colonne et pas une entrée de dictionnaire ──────────────
  ///
  /// `i18n.jsx` traduit l'INTERFACE : des libellés écrits par nous, connus à
  /// la compilation. Un nom de catégorie est de la DONNÉE, saisie par
  /// l'organisation, qui n'existe pas encore au moment où l'on écrirait la
  /// traduction. « Wildcard Solo Femme » n'a rien à faire dans un dictionnaire
  /// qu'il faudrait redéployer à chaque compète.
  ///
  /// ─── Pourquoi `null` la plupart du temps ─────────────────────────────────
  ///
  /// La plupart des noms n'ont rien à traduire : « Solo », « Tag Team »,
  /// « Loopstation », « Crew » s'écrivent pareil dans les deux langues. Obliger
  /// à remplir un second champ pour recopier le premier serait une corvée qui
  /// finirait par être bâclée. Vide veut dire « le nom français fait l'affaire »,
  /// et c'est le cas courant.
  nameEn    String?

  slug      String
  position  Int          @default(0)

  // Le jury de la catégorie, en clair. Des chaînes et non des relations vers
  // Artist : un jury comprend régulièrement des gens qui ne concourent nulle
  // part. Par catégorie et non par événement : une même compétition juge
  // rarement le Solo et le Loopstation avec le même panel.
  judges    String[]     @default([])

  /// Cette catégorie est-elle hors barème ?
  ///
  /// ─── Le cas qui l'a fait naître ──────────────────────────────────────────
  ///
  /// Une sélection de wildcards où TOUT LE MONDE passe. Le championnat de
  /// France ouvre une catégorie féminine dont toutes les inscrites sont
  /// qualifiées d'avance : il n'y a rien à deviner, et le classement demandé
  /// aux joueurs ne mesure rien du tout.
  ///
  /// Le barème savait déjà ne pas distribuer de point de qualification quand la
  /// coupe couvre tout le plateau — mais les points de PLACEMENT tombaient
  /// quand même, cinq par participante, au hasard de l'ordre saisi. Une
  /// catégorie sans enjeu distribuait ainsi plus de points qu'une finale.
  ///
  /// ─── Pourquoi ce n'est pas déductible ────────────────────────────────────
  ///
  /// « Coupe ≥ inscrits » ne suffit pas : une catégorie peut être hors barème
  /// pour des raisons qui ne se lisent nulle part dans la structure — un format
  /// démonstratif, une catégorie ouverte trop tard pour que quiconque ait pu la
  /// pronostiquer. C'est une DÉCISION de l'organisation, elle s'écrit.
  ///
  /// `false` par défaut : c'est le comportement de toutes les catégories déjà
  /// en base, et on ne retire pas rétroactivement des points déjà acquis.
  noPoints  Boolean      @default(false)

  contenders  Contender[]
  phases      Phase[]
  predictions Prediction[]
  podium      PodiumSlot[]

  @@unique([eventId, slug])
}

/// Un « Contender » est un inscrit dans une catégorie : un artiste seul (Solo),
/// un duo (Tag Team) ou un crew. On passe toujours par lui, jamais par l'artiste
/// directement, pour que les stats par artiste restent calculables.
model Contender {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Le nom affiché. Laisser vide pour suivre l'artiste rattaché : renommer
  // l'artiste se répercute alors partout, y compris dans les pronostics déjà
  // déposés. On ne le renseigne que pour un duo ou un crew dont le nom
  // n'appartient à aucun artiste isolé.
  name       String?
  seed       Int?     // seeding officiel d'entrée
  wildcard   Boolean  @default(false)
  imageUrl   String?

  artists    ContenderArtist[]

  phaseEntries      PhaseEntry[]
  battlesAsA        Battle[] @relation("BattleA")
  battlesAsB        Battle[] @relation("BattleB")
  battlesAsWinner   Battle[] @relation("BattleWinner")
  predictedRanks    PredictedRank[]
  predictedPicks    PredictedBattle[] @relation("PredA")
  predictedPicksB   PredictedBattle[] @relation("PredB")
  predictedWinners  PredictedBattle[] @relation("PredWinner")
  predictedPodium   PredictedPodium[]
  officialPodium    PodiumSlot[]
}

model ContenderArtist {
  contenderId String
  artistId    String
  contender   Contender @relation(fields: [contenderId], references: [id], onDelete: Cascade)
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([contenderId, artistId])
}

// --- Phases -------------------------------------------------------------------

enum PhaseType {
  SEEDING      // classement seul -> uniquement points d'écart
  WILDCARD     // classement + qualifiés
  ELIMINATION  // classement + qualifiés
  BRACKET      // arbre de battles
  LEGACY       // battles isolées, pas d'arbre
}

model Phase {
  id             String    @id @default(cuid())
  // Surcharge le nombre de juges de l'événement — une finale à 5 juges dans
  // une compète qui en compte 3. Vide : on suit l'événement.
  judgeCount     Int?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  type           PhaseType
  name           String    // "Wildcard", "Éliminations", "Bracket"

  /// Le nom en anglais, même règle que pour la catégorie.
  ///
  /// Indispensable et pas seulement souhaitable : sur une compétition de
  /// wildcards, la phase porte le nom de la catégorie et les deux s'affichent
  /// l'un sous l'autre. Traduire la catégorie sans traduire la phase laissait
  /// « Wildcard Solo Women » au-dessus de « Wildcard Solo Femme » — une demi-
  /// traduction se remarque plus qu'une absence de traduction.
  nameEn         String?
  position       Int       @default(0)
  qualifierCount Int?      // nb de qualifiés attendus (WILDCARD / ELIMINATION)

  /// Combien de noms un joueur peut retenir sur une SÉLECTION.
  ///
  /// Sans plafond, la stratégie gagnante est de tout prendre : sur une pioche
  /// libre, chaque nom ajouté ne peut que rapporter, jamais coûter. Quelqu'un
  /// qui verse les cinquante inscrits ramasse mécaniquement toutes les bonnes
  /// réponses et vide la compète de son intérêt — deviner n'est plus le jeu.
  ///
  /// Vide : pas de plafond, ce qui reste le comportement des sélections déjà
  /// ouvertes. On ne referme pas une compète en cours sur des joueurs qui ont
  /// composé leur liste sous une autre règle.
  maxPicks       Int?
  locksAt        DateTime? // fermeture des pronostics
  resolved       Boolean   @default(false)

  // Le tirage du premier tour, pour un BRACKET : une liste d'affiches exprimées
  // en rangs de qualification, une par slot. [[1,8],[2,7],[3,6],[4,5]] est le
  // tableau classique, mais rien n'oblige une compète à le suivre — GBB a déjà
  // opposé 1-5, 2-6, 3-7, 4-8, et une catégorie Crew peut faire autrement.
  // Vide : on retombe sur le classique, qui reste le cas le plus fréquent.
  // Un null dans une paire est un bye : ce rang passe le tour sans adversaire.
  seedPairs      Json?

  entries         PhaseEntry[]
  battles         Battle[]
  predictedRanks  PredictedRank[]
  predictedBattles PredictedBattle[]
}

/// Résultat officiel d'un contender sur une phase de classement.
model PhaseEntry {
  id          String    @id @default(cuid())
  phaseId     String
  phase       Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  contenderId String
  contender   Contender @relation(fields: [contenderId], references: [id], onDelete: Cascade)
  rank        Int?      // classement officiel, null tant que non joué
  qualified   Boolean   @default(false)

  /// Ce qualifié était-il invisible au moment des pronostics ?
  ///
  /// ─── Le cas qui l'a fait naître ──────────────────────────────────────────
  ///
  /// Le championnat de France accepte les vidéos de qualification en « non
  /// répertoriée » sur YouTube. Des candidats passent donc la sélection sans
  /// que personne, en dehors du jury, ait su qu'ils concouraient. Ils ne
  /// figuraient dans le top de AUCUN joueur — non par erreur de pronostic, mais
  /// parce que leur existence n'était pas connaissable.
  ///
  /// Sans ce drapeau, chacun de ces qualifiés coûtait à tout le monde : une
  /// place de qualification impossible à deviner, et surtout un décalage de
  /// tout le classement officiel qui rabotait les points de placement en
  /// cascade. Le barème sanctionnait une information que le jeu n'avait pas
  /// distribuée.
  ///
  /// ─── Ce que le drapeau fait ──────────────────────────────────────────────
  ///
  /// Le moteur de score retire ces lignes AVANT de comparer, et resserre les
  /// rangs restants sur 1..n. La coupe est diminuée d'autant. Le résultat est
  /// que la compète se score exactement comme si ces candidats n'avaient pas
  /// concouru : ni point gagné pour qui les aurait devinés, ni point perdu pour
  /// les autres — c'est le sens de « n'influe pas ».
  ///
  /// La ligne RESTE en base, avec son vrai rang et sa vraie qualification :
  /// c'est elle qui compose le tableau et qui s'affiche sur la page événement.
  /// On l'écarte du calcul, on ne la cache pas.
  offRadar    Boolean   @default(false)

  @@unique([phaseId, contenderId])
}

enum RoundType {
  // Un tour de 32 n'existe que sur les très gros plateaux, mais il doit figurer
  // ici pour que la base accepte les affiches correspondantes. Quatre autres
  // endroits doivent rester d'accord avec cette liste : MAIN_LINE dans
  // bracket.js, BRACKET_FORMATS et le schéma Zod des affiches dans
  // routes/admin.js, celui du dépôt dans routes/predictions.js.
  ROUND_OF_32
  ROUND_OF_16
  QUARTER
  SEMI
  SMALL_FINAL
  FINAL
  LEGACY
}

model Battle {
  id           String    @id @default(cuid())
  phaseId      String
  phase        Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  round        RoundType
  slot         Int       // position dans le tour (0,1,2,3...)
  label        String?   // "Legacy : Alem vs NaPoM"

  contenderAId String?
  contenderA   Contender? @relation("BattleA", fields: [contenderAId], references: [id])
  contenderBId String?
  contenderB   Contender? @relation("BattleB", fields: [contenderBId], references: [id])

  winnerId     String?
  winner       Contender? @relation("BattleWinner", fields: [winnerId], references: [id])
  scoreA       Int?       // votes juges (ex. 3)
  scoreB       Int?       // (ex. 0)
  played       Boolean    @default(false)

  @@unique([phaseId, round, slot])
}

/// Podium officiel d'une catégorie (top 4).
model PodiumSlot {
  id          String    @id @default(cuid())
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  rank        Int       // 1..4
  contenderId String
  contender   Contender @relation(fields: [contenderId], references: [id], onDelete: Cascade)

  @@unique([categoryId, rank])
}

// --- Pronostics ---------------------------------------------------------------

// Un pronostic. Une personne peut en garder jusqu'à dix par catégorie sous
// forme de brouillons, mais un seul compte : celui qu'elle dépose.
//
// L'unicité « un seul déposé par personne et par catégorie » est un index
// partiel PostgreSQL (WHERE submitted), que Prisma ne sait pas décrire ici. Il
// est créé dans la migration et vit dans la base : ne le retirez pas si un
// `prisma migrate dev` propose un jour de le supprimer.
model Prediction {
  id          String   @id @default(cuid())

  // Le nom que la personne donne à sa version : « safe », « si Alem tombe
  // tôt »… Vide pour la première, nommée automatiquement à l'affichage.
  label       String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  submitted   Boolean  @default(false)
  points      Int      @default(0)
  breakdown   Json?    // détail du calcul, affiché sur la fiche de résultat
  scoredAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  stamps        GroupStamp[]
  ranks   PredictedRank[]
  battles PredictedBattle[]
  podium  PredictedPodium[]

  /// La position du tampon posé sur le tableau, en fractions : {id, x, y}.
  /// JSON et non trois colonnes — c'est un tout, et la base n'a rien à
  /// interroger là-dedans. Même choix que `seedPairs` sur Phase.
  stamp     Json?

  /// La pioche d'une sélection sur vidéo : { [phaseId]: [contenderId, ...] }.
  ///
  /// Le plateau que CE joueur s'est constitué, classés compris. Il ne se déduit
  /// pas des rangs : un nom qu'on a cherché sans encore le placer n'a pas de
  /// rang, et c'était tout le bug — la pioche disparaissait au rechargement.
  ///
  /// JSON plutôt qu'une table : rien n'a jamais à être interrogé là-dedans, on
  /// lit toujours la liste entière d'un pronostic. Une table
  /// `PredictedPoolEntry` aurait ajouté trois relations pour un tableau de
  /// chaînes. Même raisonnement que `stamp` et `seedPairs`.
  pool      Json?

  // Les fils de discussion ouverts sur ce pronostic, un par groupe privé.
  comments      GroupComment[]
  notifications Notification[]

  // Plus d'unicité stricte : c'est elle qui écrasait le pronostic précédent.
  @@index([userId, categoryId])
  @@index([categoryId, submitted])
}

model PredictedRank {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  phaseId      String
  phase        Phase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  contenderId  String
  contender    Contender  @relation(fields: [contenderId], references: [id], onDelete: Cascade)
  rank         Int

  @@unique([predictionId, phaseId, contenderId])
}

model PredictedBattle {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  phaseId      String
  phase        Phase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  round        RoundType
  slot         Int

  contenderAId String?
  contenderA   Contender? @relation("PredA", fields: [contenderAId], references: [id])
  contenderBId String?
  contenderB   Contender? @relation("PredB", fields: [contenderBId], references: [id])
  winnerId     String?
  winner       Contender? @relation("PredWinner", fields: [winnerId], references: [id])
  scoreA       Int?
  scoreB       Int?

  @@unique([predictionId, phaseId, round, slot])
}

model PredictedPodium {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  rank         Int        // 1..4
  contenderId  String
  contender    Contender  @relation(fields: [contenderId], references: [id], onDelete: Cascade)

  @@unique([predictionId, rank])
}

// --- Groupes privés -------------------------------------------------------------

enum GroupRole {
  OWNER   // crée le groupe, choisit son périmètre, le transmet, le dissout
  MEMBER
}

// Un cercle privé : le classement du site restreint à quelques personnes et à
// quelques compétitions, et des commentaires sur les pronostics les uns des
// autres.
//
// Rien ici n'est visible du public. Un groupe n'apparaît nulle part sur le
// site : on y entre par un lien, jamais par une recherche.
model Group {
  id          String   @id @default(cuid())
  // Le slug sert l'URL. Dérivé du nom, suffixé d'un fragment aléatoire :
  // deux groupes peuvent légitimement s'appeler « Les potes ».
  slug        String   @unique
  name        String
  description String?
  stamps        GroupStamp[]

  // Le code d'invitation, porté par le groupe plutôt que par une table de
  // jetons : une invitation n'a ni destinataire ni échéance, elle ouvre la
  // porte à qui possède le lien. Une table apporterait une traçabilité dont
  // personne n'a besoin, et un cycle de vie à purger. Le renouvellement du
  // code est le seul geste qui referme un lien ayant fuité.
  //
  // C'est aussi ce code qui rend l'approbation inutile : le lien EST
  // l'autorisation. Un sas de validation par-dessus demanderait deux fois la
  // même permission.
  inviteCode  String   @unique
  // Fermer les inscriptions sans changer le code : le lien déjà partagé cesse
  // d'ouvrir, et rouvrir plus tard ne demande pas de le repartager.
  inviteOpen  Boolean  @default(true)

  createdAt   DateTime @default(now())

  members       GroupMember[]
  events        GroupEvent[]
  comments      GroupComment[]
  notifications Notification[]
}

// Les compétitions que le groupe suit, choisies par son propriétaire.
//
// La liste peut être vide, et vide ne signifie PAS « toutes ». Un groupe monté
// pour GBB 2026 ne doit pas se mettre à compter les points d'une compète
// ajoutée six mois plus tard sans que personne l'ait décidé : le classement
// changerait tout seul, et des pronostics hors sujet apparaîtraient à
// commenter. Vide signifie « rien de configuré », et la fiche le dit.
//
// Ce périmètre gouverne les trois choses ensemble : le classement, les
// pronostics affichés, et ce qui est commentable.
model GroupEvent {
  groupId String
  group   Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([groupId, eventId])
  @@index([eventId])
}

// L'appartenance, et avec elle la propriété.
//
// Un `ownerId` sur Group permettrait de désigner quelqu'un qui n'est pas
// membre, et le transfert deviendrait deux écritures à garder cohérentes. Ici
// le propriétaire est membre par construction, et transmettre le titre est un
// seul UPDATE sur deux lignes.
//
// « Un seul propriétaire par groupe » est un index partiel PostgreSQL
// (WHERE role = 'OWNER'), que Prisma ne sait pas décrire : il est créé dans la
// migration et vit dans la base — comme celui du pronostic déposé. Ne le
// retirez pas si un `prisma migrate dev` propose un jour de le supprimer.
model GroupMember {
  groupId  String
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@id([groupId, userId])
  // « Mes groupes » interroge par personne, et le quota de cinq adhésions se
  // compte de la même façon : sans cet index, chaque contrôle parcourt toutes
  // les adhésions du site.
  @@index([userId])
}

// Un commentaire sur le pronostic de quelqu'un, à l'intérieur d'un groupe.
//
// La clé est le couple (groupe, pronostic), pas le pronostic seul : le même
// pronostic commenté dans deux cercles garde deux fils distincts, et personne
// ne lit les remarques d'un groupe auquel il n'appartient pas.
//
// Pas de réponses imbriquées ni de mentions : la demande était de pouvoir
// réagir aux pronostics, pas d'ouvrir une messagerie.
model GroupComment {
  id           String     @id @default(cuid())
  groupId      String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body         String

  // Le point de la fiche auquel la bulle est accrochée.
  //
  // Une clé, pas des coordonnées d'écran : « rank:<phaseId>:<contenderId> »,
  // « battle:<phaseId>:<ROUND>:<slot> », « podium:<rang> ». Des pixels absolus
  // seraient justes le jour de la pose et faux à la première largeur d'écran
  // différente, au premier repli de colonne, au premier ajout de phase. La clé
  // désigne un élément du pronostic, qui se retrouve quel que soit l'affichage.
  //
  // Vide : commentaire général, sans ancre, affiché dans le fil du bas.
  anchorKey    String?
  // Le décalage DANS la boîte de l'élément visé, en fractions de sa largeur et
  // de sa hauteur (0 à 1). C'est ce qui permet de poser deux bulles à deux
  // endroits d'une même affiche sans qu'elles se superposent.
  anchorX      Float?
  anchorY      Float?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  // Renseigné à la première modification : un commentaire retouché après coup
  // ne doit pas pouvoir se faire passer pour l'original.
  editedAt     DateTime?

  // L'ordre de lecture d'un fil : groupe, pronostic, chronologie. Les ancres
  // sont regroupées côté client — une fiche en porte quelques dizaines au
  // maximum, un index de plus ne gagnerait rien.
  @@index([groupId, predictionId, createdAt])
  @@index([authorId])
}

// --- Notifications ---------------------------------------------------------------

enum NotificationKind {
  GROUP_JOIN       // quelqu'un est entré dans un groupe que vous possédez
  COMMENT_ON_MINE  // quelqu'un a commenté votre pronostic
  COMMENT_REPLY    // quelqu'un a écrit dans un fil où vous étiez intervenu
  // Les pronostics d'une compétition viennent d'ouvrir. Le seul avis que le
  // SITE envoie, sans personne derrière : `actorId` reste vide, et la phrase
  // ne cite aucun nom.
  EVENT_OPEN
}

// Un avis destiné à une personne.
//
// Des lignes plutôt qu'un compteur : un compteur dirait « trois choses »
// sans dire lesquelles, et repartirait faux au premier incident. Ici chaque
// avis porte de quoi se rendre à son origine, et `readAt` distingue le vu du
// non-vu sans rien effacer.
//
// Aucun envoi par courriel ni par Discord. Le site relaie déjà la boîte à
// idées vers Discord parce que personne ne surveille une base de données ; un
// avis de commentaire, lui, s'adresse à quelqu'un qui reviendra sur le site de
// toute façon. Le point rouge sur la cloche suffit.
model Notification {
  id           String           @id @default(cuid())
  // Le destinataire.
  userId       String
  user         User             @relation("Notified", fields: [userId], references: [id], onDelete: Cascade)
  kind         NotificationKind

  // Qui l'a déclenché. Nullable et `SetNull` : un compte supprimé ne doit pas
  // emporter les avis reçus par les autres, qui restent lisibles sans nom.
  actorId      String?
  actor        User?            @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  // Le contexte, pour composer le message et fabriquer le lien de retour.
  // Tout part en cascade : un groupe dissous n'a pas à laisser derrière lui
  // des avis qui mènent à une page inexistante.
  groupId      String?
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  predictionId String?
  prediction   Prediction?      @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  // L'événement dont il est question. Porte aussi la garde d'unicité : un avis
  // d'ouverture existant POUR CET ÉVÉNEMENT est la preuve qu'il a été envoyé,
  // là où un drapeau sur l'événement pourrait mentir si l'insertion a échoué.
  eventId      String?
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)

  readAt       DateTime?
  createdAt    DateTime         @default(now())

  // L'index de la seule requête qui compte : mes avis non lus, du plus récent
  // au plus ancien. `readAt` en deuxième position parce que le décompte des
  // non-lus tourne à chaque chargement de page.
  @@index([userId, readAt, createdAt])
  // « Cet événement a-t-il déjà été annoncé ? » — une requête d'existence, qui
  // tourne à chaque passage d'un événement en pronostics ouverts.
  @@index([kind, eventId])
}

// --- Boîte à idées -------------------------------------------------------------

enum PostboxKind {
  SUGGESTION // une compète à ajouter, une idée de fonctionnalité
  BUG        // quelque chose qui ne marche pas
}

// Un message envoyé depuis l'accueil, relayé sur Discord dans le salon qui
// correspond à sa catégorie.
//
// On garde la ligne en base même après relais : c'est elle qui porte le quota
// mensuel — dix par personne et par mois civil, comptés à la requête plutôt que
// dans un compteur à part, qui se désynchroniserait au premier échec d'envoi.
// Et si le webhook tombe, on sait exactement ce qui n'est jamais parti.
model PostboxMessage {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      PostboxKind
  body      String
  createdAt DateTime    @default(now())
  // Faux tant que Discord n'a pas accusé réception : le message compte quand
  // même dans le quota, sinon un webhook en panne ouvrirait la porte au spam.
  delivered Boolean     @default(false)
  failure   String?     // la raison du refus, pour savoir quoi rejouer

  @@index([userId, createdAt])
  @@index([delivered, createdAt])
}

// --- Fréquentation -------------------------------------------------------------

// Une ligne par personne et par journée où elle s'est manifestée.
//
// User.lastSeenAt ne retient que la dernière visite : il dit qui est là
// aujourd'hui, jamais qui était là mardi dernier. Impossible d'en tirer une
// courbe. Cette table garde la trace, une ligne par jour et par personne, ce
// qui donne les actifs quotidiens sans jamais compter deux fois la même
// personne qui recharge la page vingt fois.
//
// `day` est une chaîne AAAA-MM-JJ calculée en Europe/Paris, pas un DateTime :
// une journée est une notion locale, et un horodatage UTC coupe les journées à
// 2 h du matin l'été. Le tri lexicographique d'une date ISO est chronologique,
// les intervalles fonctionnent donc normalement.
model Visit {
  userId String
  day    String
  seenAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

// --- Cosmétique : badges et porte-monnaie --------------------------------------

// Les sept badges d'événement. Une énumération et non une table : un badge n'a
// pas d'état propre — son visuel, son libellé et sa condition vivent dans
// cosmetics.js, la base ne retient que QUI l'a gagné et SUR QUELLE compète.
enum BadgeCode {
  PARTICIPANT // au moins un pronostic déposé sur la compète
  BRONZE      // top 60 % du classement de la compète
  SILVER      // top 30 %
  GOLD        // top 5 %
  PODIUM_3    // troisième pronostiqueur de la compète
  PODIUM_2    // deuxième
  PODIUM_1    // vainqueur
}

// Un badge gagné par une personne sur une compétition.
//
// L'attribution se rejoue intégralement à chaque passage de l'événement en
// FINISHED : tout supprimer puis tout recréer rend l'opération idempotente —
// re-clôturer après un recalcul de points CORRIGE le palmarès, il ne le
// duplique jamais. L'unicité (personne, compète, badge) est la ceinture de
// sécurité si deux clôtures se croisent.
model BadgeAward {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code      BadgeCode
  awardedAt DateTime  @default(now())

  @@unique([userId, eventId, code])
  // Le mur de badges d'un profil interroge par personne ; la re-clôture d'une
  // compète supprime par événement.
  @@index([userId])
  @@index([eventId])
}

enum WalletKind {
  EVENT_POINTS // crédit à la clôture d'une compète
  PURCHASE     // débit à l'achat d'un cosmétique
  GRANT        // crédit ou retrait décidé par un organisateur
}

// Le porte-monnaie est un livre de comptes, jamais un compteur.
//
// Un solde stocké sur User dirait « 340 » sans dire d'où, et repartirait faux
// au premier incident — exactement le travers que les notifications et le
// quota de la boîte à idées évitent déjà. Ici le solde EST la somme des
// lignes : impossible à désynchroniser, et l'historique des gains et des
// achats vient gratuitement.
//
// Le score du classement, lui, ne bouge jamais : il reste la somme des
// `Prediction.points`. Dépenser n'y touche pas — les deux compteurs demandés
// sont ce score gravé d'un côté, et cette somme de lignes de l'autre.
model WalletEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      WalletKind
  // Positif pour un crédit, négatif pour un achat. Un seul signe par ligne :
  // le solde est un SUM sans condition.
  amount    Int

  // Pour un EVENT_POINTS : la compète créditrice. `SetNull` et non cascade —
  // supprimer une vieille compète ne doit pas reprendre un argent peut-être
  // déjà dépensé, ce qui rendrait des soldes négatifs.
  eventId   String?
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // Pour un PURCHASE : l'identifiant de l'objet dans cosmetics.js. C'est cette
  // ligne qui PROUVE la possession — pas de table d'inventaire à part.
  itemId    String?

  /// Le motif d'un crédit manuel. Obligatoire côté route, nullable en base :
  /// les écritures d'avant cette migration n'en ont pas, et rien ne sert de
  /// leur en inventer un.
  note        String?

  /// Qui a passé l'écriture. Sans relation Prisma : la ligne doit survivre à
  /// la suppression du compte de l'organisateur qui l'a créée, et on
  /// n'interroge jamais dans l'autre sens.
  grantedById String?

  createdAt DateTime   @default(now())

  // Deux unicités qui cohabitent grâce aux NULL de PostgreSQL (des NULL ne
  // sont jamais égaux entre eux) :
  //  - un seul crédit par (personne, compète) : la re-clôture UPSERT le
  //    montant au lieu d'empiler des lignes — les achats, sans eventId,
  //    ne sont pas concernés ;
  //  - un objet ne s'achète qu'une fois — les crédits, sans itemId,
  //    ne sont pas concernés.
  @@unique([userId, eventId])
  @@unique([userId, itemId])
  @@index([userId])
}

/// Une consultation de profil ou de fiche d'artiste.
///
/// Une ligne par visiteur, par cible et par JOURNÉE — jamais par clic. Compter
/// les clics donnerait un nombre que n'importe qui fabrique en maintenant F5.
model ProfileView {
  id        String   @id @default(cuid())
  viewerId  String
  viewer    User     @relation("ProfileViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  /// La cible : un joueur OU un artiste, jamais les deux.
  userId    String?
  user      User?    @relation("ProfileViewed", fields: [userId], references: [id], onDelete: Cascade)
  artistId  String?
  artist    Artist?  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  /// La journée locale, au format AAAA-MM-JJ. Même unité que `Visit`.
  day       String
  createdAt DateTime @default(now())

  /// Les deux unicités cohabitent grâce aux NULL de PostgreSQL : deux NULL ne
  /// sont jamais égaux, donc une vue d'artiste échappe à la première et une vue
  /// de joueur à la seconde. Le mécanisme de WalletEntry, déjà éprouvé.
  @@unique([viewerId, userId, day])
  @@unique([viewerId, artistId, day])
  @@index([userId])
  @@index([artistId])
}

/// Le classement de popularité de la boutique, recalculé tous les deux jours.
///
/// Remplacé en bloc à chaque calcul : il n'y a rien à conserver d'un classement
/// périmé. Aucune clé étrangère vers un catalogue — celui-ci vit dans le code, et
/// un objet retiré laisse une ligne que le prochain calcul balaiera.
model ShopTrend {
  itemId     String   @id
  purchases  Int      @default(0)
  position   Int

  /// L'horloge des deux jours. C'est la DATE du dernier calcul qui décide du
  /// prochain, jamais une planification cron — celle-ci dérive au premier
  /// redémarrage tombant un jour impair.
  computedAt DateTime @default(now())

  @@index([position])
}

/// Les promotions de la semaine, tirées parmi les objets les moins achetés.
model ShopPromo {
  itemId   String   @id
  percent  Int
  startsAt DateTime @default(now())
  endsAt   DateTime

  /// La lecture filtre toujours sur « encore valable » : c'est cet index qui
  /// porte chaque ouverture de la boutique.
  @@index([endsAt])
}